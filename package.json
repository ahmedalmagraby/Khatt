{
  "name": "khatt",
  "description": "Beautiful Arabic text on any website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "fonts": "node scripts/copy-fonts.mjs",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "site-check": "wxt build && node scripts/site-check.mjs",
    "postinstall": "wxt prepare",
    "icons": "node scripts/make-icons.mjs",
    "store-assets": "wxt build && node scripts/make-store-assets.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/noto-kufi-arabic": "^5.3.0",
    "@fontsource-variable/noto-naskh-arabic": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "@playwright/test": "latest",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
